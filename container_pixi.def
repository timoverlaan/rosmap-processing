# Version: see pixi.toml (container_pixi_<version>.sif, built by build_and_upload.sh)

# Header
Bootstrap: docker
From: ghcr.io/prefix-dev/pixi:0.67.2-noble

# Files
%files
    pixi.toml /opt/app/pixi.toml
    pixi.lock /opt/app/pixi.lock
    install_deps.R /opt/app/install_deps.R

# Install dependencies
%post
    apt update
    apt install -y git strace

    cd /opt/app

    # Setup pixi dependencies (the gpu environment needs CUDA 12; there is no
    # GPU driver during the build, so declare it)
    export CONDA_OVERRIDE_CUDA=12.9
    pixi install --all

    # Clean up
    rm -rf ~/.cache/rattler

    # R dependencies (in the install_deps.R script)
    pixi run Rscript install_deps.R
    rm install_deps.R